# Backend local development. Copy to backend/.env (untracked) and replace every placeholder.
# Nothing here is a real credential: the application has NO fallback for secrets in any profile,
# so each value marked change-me must be set (here or as a real environment variable).
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:oracle:thin:@localhost:1521/XEPDB1
DB_USERNAME=change-me
DB_PASSWORD=change-me

# JWT signing secret: generate one, e.g.  openssl rand -base64 48  (minimum 32 bytes)
JWT_SECRET=change-me-generate-a-random-value-of-at-least-32-bytes

# Wompi (payments). Sandbox keys come from your own Wompi sandbox account; leave empty to disable payments.
WOMPI_ENVIRONMENT=SANDBOX
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Allowed browser origins (comma separated). The dev profile defaults to the local Vite ports.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# E-mail through Brevo (HTTPS API). Without BREVO_API_KEY e-mails are only logged (simulation).
BREVO_API_KEY=
# Verified sender in your Brevo account; defaults to no-reply@example.invalid, which Brevo will reject.
BREVO_SENDER_EMAIL=no-reply@example.invalid
BREVO_SENDER_NAME=SAED
