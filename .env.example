# Frontend build-time environment (read by Vite).
# Copy to .env and adjust as needed. Do NOT commit real .env files.

# Backend API base URL. Priority used by client/lib/api.js:
#   1. VITE_API_BASE_URL (this file / CI / deploy)
#   2. window._API_BASE_URL (legacy static-host compat)
#   3. http://localhost:8080/api when running from file:// or localhost
#   4. https://sistema-administracion-edificios.onrender.com/api (production default)
# Leave empty to fall through to the defaults above.
VITE_API_BASE_URL=

# Optional base path for the built assets (see vite.config.js).
# Example: VITE_BASE_PATH=/saed/ for GitHub Pages under a subpath.
VITE_BASE_PATH=

# Backend runtime environment (Java). Copy into the server env / Render envVars.
# Email sending: SMTP directo a Gmail requiere un APP PASSWORD (no la password
# de la cuenta). Si no se configura, el envío falla rápido con mensaje claro.
# GMAIL_APP_PASSWORD=
# GMAIL_USER=gestion.residencias.upc@gmail.com
# SENDGRID_API_KEY=