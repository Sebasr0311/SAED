# ==============================================================================
# SAED 2.0 — .gitignore Oficial
# ==============================================================================

# IDE & Editor files
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.project
*.classpath
*.settings/
*.sublime-project
*.sublime-workspace

# Environment & Sensitive Credentials
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.sso
*.jks
**/bd.properties
**/wallet.zip
**/wallet_base64.txt
wallet_part*.txt

# Build & Compilation (Java / Maven)
target/
**/target/
bin/
**/bin/
out/
**/out/
*.class
.mvn/wrapper/maven-wrapper.jar

# Build & Dependencies (Node / Frontend)
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
.npm/
.pnpm-store/

# Test Outputs & Coverage
coverage/
test-results/
**/test-results/
playwright-report/
**/playwright-report/
blob-report/
testsprite_tests/
**/testsprite_tests/

# Runtime Uploads & Generated Media
uploads/
**/uploads/
backend/uploads/

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dev-*.log
preview.log

# Temporary, Cache & Backup files
*.tmp
*.bak
*.swp
*~
temp.*
fix*.js
local/

# OS-Specific Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Local Tooling & Assistant Cache
.atl/
.codegraph/
.playwright-mcp/
